#!/bin/sh
# Run both self-tests before anything leaves the machine: the drift checker's,
# then the hooks' own, so a broken hook script cannot be pushed either.
#
# Enable once per clone, the same setting that turns on the pre-commit guard:
#     git config core.hooksPath hooks
#
# Opt out for one push:   SKIP_SELFTEST=1 git push
if [ -n "${SKIP_SELFTEST:-}" ]; then
    echo "test-doc-drift: skipped (SKIP_SELFTEST set)" >&2
    exit 0
fi

cd "$(git rev-parse --show-toplevel)" || exit 1

# Git exports these to hooks. The self-test builds throwaway repositories, and
# an inherited GIT_DIR would point those commands at this one instead.
unset GIT_DIR GIT_WORK_TREE GIT_INDEX_FILE GIT_PREFIX

if [ ! -f test-doc-drift.py ]; then
    echo "test-doc-drift: test-doc-drift.py is missing from the repository root." >&2
    echo "  Restore it, or bypass with: SKIP_SELFTEST=1 git push" >&2
    exit 1
fi

if [ ! -f test-hooks.py ]; then
    echo "test-hooks: test-hooks.py is missing from the repository root." >&2
    echo "  Restore it, or bypass with: SKIP_SELFTEST=1 git push" >&2
    exit 1
fi

if command -v python >/dev/null 2>&1; then PY=python
elif command -v python3 >/dev/null 2>&1; then PY=python3
else
    echo "test-doc-drift: no python on PATH." >&2
    echo "  Install python, or bypass with: SKIP_SELFTEST=1 git push" >&2
    exit 1
fi

"$PY" test-doc-drift.py || exit 1

# test-hooks.py pushes inside throwaway repositories whose pre-push is a copy of
# this hook, so a third self-test would start from there. The marker stops that:
# the copy still runs test-doc-drift.py, which is what its cases test, and then
# returns instead of recursing.
if [ -n "${GMAX_IN_HOOK_SELFTEST:-}" ]; then
    exit 0
fi
GMAX_IN_HOOK_SELFTEST=1
export GMAX_IN_HOOK_SELFTEST

exec "$PY" test-hooks.py
