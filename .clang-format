BasedOnStyle: LLVM
Standard: c++20
IndentWidth: 4
ColumnLimit: 100
DerivePointerAlignment: false
PointerAlignment: Left
# The closing-brace comment convention is `}  // namespace foo`, which is what
# the sources use; LLVM's default of one space would rewrite every closure line.
SpacesBeforeTrailingComments: 2
